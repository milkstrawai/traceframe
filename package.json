{
  "name": "@milkstraw/traceframe",
  "version": "0.1.0",
  "description": "Record scripted browser flows and render smooth cursor overlays into video.",
  "keywords": [
    "playwright",
    "screen-recording",
    "video",
    "demo",
    "cursor",
    "browser-automation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/milkstrawai/traceframe.git"
  },
  "homepage": "https://github.com/milkstrawai/traceframe#readme",
  "bugs": "https://github.com/milkstrawai/traceframe/issues",
  "type": "module",
  "bin": {
    "traceframe": "src/cli.mjs"
  },
  "exports": {
    ".": "./src/index.mjs"
  },
  "files": [
    "src",
    "docs/recording-flows.md",
    "examples/recipes.html",
    "examples/recipes-flow.mjs"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "test:smoke": "node scripts/smoke.mjs",
    "test:package": "node scripts/package-smoke.mjs",
    "build:assets": "node scripts/build-assets.mjs"
  },
  "dependencies": {
    "playwright": "1.64.1"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
